{
  "name": "quark-drive-master-extension",
  "version": "3.0.2",
  "description": "专为夸克网盘打造的全能自动化管理助手，支持批量重命名、批量文件删除、新建文件夹、CSV导入导出、繁简转换与一键撤销。",
  "main": "background.js",
  "scripts": {
    "check": "node scripts/verify-versions.js",
    "lint": "npm run check",
    "pack": "node scripts/pack.js",
    "build": "npm run check && npm run pack"
  },
  "keywords": [
    "quark",
    "chrome-extension",
    "batch-rename",
    "manifest-v3",
    "lz7"
  ],
  "author": "LZ7工作室",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZ7TOP/quark-drive-master-extension.git"
  },
  "homepage": "https://github.com/LZ7TOP/quark-drive-master-extension#readme",
  "bugs": {
    "url": "https://github.com/LZ7TOP/quark-drive-master-extension/issues"
  }
}
